{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italycircularfashion.github.io/PratoHubMagazine/assets/data/companies.schema.json",
  "title": "PratoHubMagazine Public Company (PUBLIC Directory)",
  "description": "Schema pubblico definito 2026-11-05. Distinzione esplicita tra verifica identita, verifica informazioni, ammissibilita pubblicazione. publish.allowed=false di default. Niente P.IVA fittizie nei nuovi dati.",
  "type": "object",
  "required": ["id", "name", "comune", "datasetType", "verification", "publish"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Slug stabile pubblico, mai id interno SQLite"},
    "name": {"type": "string", "minLength": 2},
    "comune": {"type": "string"},
    "district": {"type": ["string", "null"], "enum": ["PO", "OT", "PI", null]},
    "legalForm": {"type": ["string", "null"]},
    "website": {"type": ["string", "null"], "format": "uri"},
    "vatNumber": {"type": ["string", "null"], "description": "Solo se verificata camerale; null altrimenti. Mai inventata."},
    "rea": {"type": ["string", "null"]},
    "texCodes": {"type": "array", "items": {"type": "object", "required": ["code", "label", "confidence", "source"], "properties": {"code": {"type": "string", "pattern": "^TX-\\d{2}(\\.\\d{2}){0,2}$"}, "label": {"type": "string"}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "source": {"type": "string", "format": "uri"}}}},
    "sectorsB2B": {"type": "array", "items": {"enum": ["tessile", "filati", "tessitura", "tintoria-finissaggio", "abbigliamento", "maglieria", "confezione", "taglio-modellistica", "stireria-qc", "terzisti", "fornitori-servizi", "laboratori"]}},
    "description": {"type": ["string", "null"]},
    "foundedYear": {"type": ["integer", "null"]},
    "employeeRange": {"type": ["string", "null"]},
    "certifications": {"type": "array", "items": {"type": "string"}},
    "productSectors": {"type": "array", "items": {"type": "string"}},
    "exportMarkets": {"type": "array", "items": {"type": "string"}},
    "technologies": {"type": "array", "items": {"type": "string"}},
    "sustainabilityHighlights": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["type", "url"], "properties": {"type": {"enum": ["CAMERA", "WEBSITE", "DOCUMENTO_VERIFICATO"]}, "url": {"type": "string", "format": "uri"}, "checkedAt": {"type": "string"}}}},
    "datasetType": {"enum": ["DEMO", "REAL"], "description": "DEMO=dimostrativo fittizio, REAL=anagrafica reale verificata. Mantenere separati."},
    "verification": {
      "type": "object",
      "required": ["identity", "information", "publishEligibility"],
      "properties": {
        "identity": {"enum": ["VERIFIED_AUTHORITATIVE", "IDENTIFIED_UNVERIFIED", "DEMO"], "description": "Verifica identita aziendale. P.IVA da sola non basta. Requisito: fonte autorevole + ragione sociale normalizzata + comune confermato."},
        "information": {"enum": ["VERIFIED_AUTHORITATIVE", "IDENTIFIED_UNVERIFIED", "DEMO"], "description": "Verifica delle singole informazioni (TX, certificazioni, attività). Ogni campo con fonte."},
        "publishEligibility": {"enum": ["ELIGIBLE_AFTER_REVIEW", "NOT_ELIGIBLE", "DEMO_FORBIDDEN"], "description": "Ammissibilita pubblicazione. DEMO_FORBIDDEN per DEMO."}
      }
    },
    "publish": {
      "type": "object",
      "required": ["allowed", "reason"],
      "properties": {"allowed": {"type": "boolean", "default": false}, "reason": {"type": "string"}}
    }
  },
  "additionalProperties": false
}
